APP_ENV=development
APP_NAME=pos-saas-api
HTTP_ADDR=:8080

DATABASE_URL=postgres://pos_app:pos_app@localhost:5432/pos_saas?sslmode=disable
REDIS_URL=redis://localhost:6379/0

JWT_ISSUER=pos-saas
JWT_AUDIENCE=pos-client
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_SECRET_CHANGE_ME=change-this-development-secret-to-a-long-random-value

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_LOGIN_PER_MINUTE=10
