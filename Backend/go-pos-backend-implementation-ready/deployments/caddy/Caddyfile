# Caddy reverse proxy for the containerized production stack.
# SITE_DOMAIN is provided by docker-compose.prod.yml (set it in .env.prod).
# With a real domain, Caddy provisions and renews TLS automatically.
{$SITE_DOMAIN:localhost} {
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}

# Prometheus /metrics is only for the monitoring collector. SCRAPE_METRICS_ONLY_IP
# is the collector's (or the scrape host's) source IP; everything else gets 403.
:9090 {
	@metrics path /metrics
	@scrape_allowed remote_ip {$SCRAPE_IP:127.0.0.1}

	handle @metrics {
		handle @scrape_allowed {
			reverse_proxy api:8080
		}
		respond "forbidden" 403
	}
	respond "not found" 404
}