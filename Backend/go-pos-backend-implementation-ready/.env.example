APP_ENV=development
APP_NAME=pos-api
HTTP_ADDR=:8080

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

DATABASE_URL=postgres://pos_app:pos_app_dev_password@127.0.0.1:5432/pos
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ISSUER=pos-api
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
MAX_SESSIONS_PER_USER=5

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Set false to disable the Prometheus /metrics endpoint + middleware entirely
# (default true); otherwise protect it in the proxy with a collector allowlist.
METRICS_ENABLED=true

LOG_LEVEL=info
LOG_FORMAT=json

SYNC_CURSOR_TTL=720h

# ── Free-trial & identity policy ────────────────────────────────────────────
# The backend is the sole authority on trial duration, scope and dates. The
# client never supplies any of these values.
TRIAL_DURATION_DAYS=14
TRIAL_SCOPE=account                 # account | organization | verified_phone | business_identity
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_PHONE_VERIFICATION=false
REQUIRE_DEVICE_INTEGRITY=false
MAX_ORGANIZATIONS_PER_ACCOUNT=3
MAX_ACTIVE_INSTALLATIONS=10
SUSPICIOUS_REGISTRATION_POLICY=review   # allow | review | deny
OFFLINE_TRIAL_POLICY=grace24h
REGISTER_RATE_PER_IP_PER_HOUR=5
EMAIL_TOKEN_TTL=15m
OTP_TTL=5m
PROMO_TRIALS_ENABLED=false
# Verification delivery backends; "noop" keeps verification off/bypassed until
# a real provider is wired (codes are never logged or stored in plaintext).
MAILER=noop                         # noop | smtp
SMS_SENDER=noop                     # noop | provider
