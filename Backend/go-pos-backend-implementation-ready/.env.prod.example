# Production deployment variables for docker-compose.prod.yml
# Copy to .env.prod and replace every CHANGE_ME value before deploying.

# Compose
COMPOSE_PROJECT_NAME=pos-prod
IMAGE_TAG=latest

# Public endpoints
SITE_DOMAIN=localhost
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# PostgreSQL
POSTGRES_DB=pos
POSTGRES_USER=pos_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# API
JWT_ISSUER=pos-api
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ACCESS_SECRET_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_REFRESH_SECRET_AT_LEAST_32_BYTES
LOG_LEVEL=info