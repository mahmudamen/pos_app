# Production deployment variables for docker-compose.prod.yml
# Copy to .env.prod and replace every CHANGE_ME value before deploying.

# Compose
COMPOSE_PROJECT_NAME=pos-prod
IMAGE_TAG=latest

# Public endpoints
# Three disjoint surfaces, each served by its own hostname:
#   COMPANY_DOMAIN — company site, no API at all
#   SAAS_DOMAIN    — console sign-in + control plane + /admin/ single-page app
#   POS_DOMAIN     — POS.Go landing, self-ordering and the store API
# SURFACE_ROUTING_ENABLED makes the API refuse paths that belong to another
# domain (404 not_available_on_host) and keeps the two sign-in audiences apart
# (403 wrong_surface). Keep it true on production, false for single-domain hosts.
SITE_DOMAIN=posgo.xamltech.com
COMPANY_DOMAIN=xamltech.com
SAAS_DOMAIN=api.xamltech.com
POS_DOMAIN=posgo.xamltech.com
SURFACE_ROUTING_ENABLED=true
API_PORT=8080
CORS_ALLOWED_ORIGINS=https://xamltech.com,https://api.xamltech.com,https://posgo.xamltech.com

# Login brute-force throttle. Only FAILED logins count (401): the limiter refunds
# its token on a success or a 5xx, so staff sharing one NAT/carrier IP are not
# locked out of signing in by each other. 10 wrong passwords per minute per IP
# still caps credential stuffing at 600/hour.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=1m

# Which hops may set X-Forwarded-For. Empty means loopback + the private
# container network + Cloudflare's published edge ranges, which is correct for
# the Caddy-in-front-of-the-API topology below. Only set this if an extra proxy
# is added in front of Caddy. 0.0.0.0/0 and ::/0 are rejected at startup: they
# hand the client address back to whoever sent the header, which defeats every
# per-IP rate limit (login, /v1/saas, registration, community join).
TRUSTED_PROXIES=

# PostgreSQL
POSTGRES_DB=pos
POSTGRES_USER=pos_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# API
JWT_ISSUER=pos-api
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_ACCESS_SECRET_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_REFRESH_SECRET_AT_LEAST_32_BYTES
LOG_LEVEL=info

# API rate limit (applies to the /v1/saas control plane per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1m

# Invoice capture (Tesseract, inside the API container).
# The Purchases screen ships in the Android app for managers only, so leaving
# this false ships a button that answers 503 ocr_unavailable.
# The meter is per tenant, per rolling window, and 0 means UNLIMITED — which on
# production is a denial-of-service footgun, because each scan runs
# synchronously on the request goroutine. Leave the limits non-zero.
OCR_ENABLED=true
TESSERACT_BIN=tesseract
# Needs both data packs. The image installs tesseract-ocr-data-ara and
# tesseract-ocr itself, which pulls in the English pack; verify with
# `docker exec pos-prod-api tesseract --list-langs` after the first deploy.
TESSERACT_LANGS=ara+eng
TESSERACT_PSM=6
OCR_DAY_LIMIT=100
OCR_WEEK_LIMIT=500
OCR_DAY_LIMIT=100
OCR_WEEK_LIMIT=500
OCR_MONTH_LIMIT=2000

# Transactional email. Set MAILER=smtp to deliver (welcome, password reset,
# notifications, invoice emails, SaaS admin compose). SMTP_HOST is required
# when MAILER=smtp; STARTTLS on SMTP_PORT (587). These must be forwarded by
# the api service's environment block in docker-compose.prod.yml.
MAILER=noop
MAIL_FROM=support@xamltech.com
MAIL_FROM_NAME=POS.Go
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USERNAME=support@xamltech.com
# SMTP_PASSWORD=