{
  "name": "xamltech-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-content.mjs && vite",
    "gen": "node scripts/gen-content.mjs",
    "build": "node scripts/gen-content.mjs && tsc --noEmit && vite build && vite build --ssr src/ssr.tsx --outDir dist-server --emptyOutDir && node scripts/prerender.mjs",
    "build:client": "node scripts/gen-content.mjs && vite build",
    "build:ssr": "vite build --ssr src/ssr.tsx --outDir dist-server --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}