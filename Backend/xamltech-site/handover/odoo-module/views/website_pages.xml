<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ROOT COMMENTS MOVED INSIDE TEMPLATE -->
    <!--
        Register each controller-served page as a website.page record so it:
        - Appears in the website editor's page list (Website ▶ Pages)
        - Gets SEO fields (title, meta description) editable from the backend
        - Can be published/unpublished from the website editor toolbar
    -->

    <record id="page_contact" model="website.page">
        <field name="view_id" ref="contact_page"/>
        <field name="url">/contact-us</field>
        <field name="website_published">True</field>
        <field name="is_homepage">False</field>
    </record>

    <record id="page_store" model="website.page">
