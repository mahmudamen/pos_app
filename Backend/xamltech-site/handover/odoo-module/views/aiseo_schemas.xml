    <!-- ═══════════════════════════════════════════════════════════
         §3. SpeakableSpecification — Homepage
         Helps voice assistants and AI know which text to read aloud.
         ═══════════════════════════════════════════════════════════ -->
    <template id="aiseo_homepage_speakable"
              inherit_id="xamltech_addons_store.homepage"
              priority="99">
        <xpath expr="//t[@t-set='meta_description']" position="after">
            <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "XamlTech — Odoo ERP, IT &amp; AI Solutions in Egypt",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".xt-hero__h1", ".xt-hero__sub", ".xt-h2"]
  },
  "url": "https://xamltech.com"
}</script>
        </xpath>
    </template>

