<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        AISEO (AI Search Engine Optimization) Schemas
        ==============================================
        JSON-LD structured data to make the site optimally readable
        by AI crawlers: ChatGPT, Perplexity, Google AI Overviews, Bing Copilot.
    -->

    <!-- ═══════════════════════════════════════════════════════════
         §1. SiteNavigationElement — helps AI understand site structure
         Injected into website.layout so it appears on every page.
         ═══════════════════════════════════════════════════════════ -->
    <template id="aiseo_site_navigation"
              name="AISEO Site Navigation Schema"
              inherit_id="website.layout"
              priority="99">
        <xpath expr="//head" position="inside">
            <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": "Main Navigation",
  "hasPart": [
    {"@type": "SiteNavigationElement", "name": "Home", "url": "https://xamltech.com/"},
    {"@type": "SiteNavigationElement", "name": "ERP Solutions", "url": "https://xamltech.com/solutions/erp"},
    {"@type": "SiteNavigationElement", "name": "IT Infrastructure", "url": "https://xamltech.com/solutions/it-infrastructure"},
    {"@type": "SiteNavigationElement", "name": "Web Development", "url": "https://xamltech.com/solutions/web"},
    {"@type": "SiteNavigationElement", "name": "AI Copilots", "url": "https://xamltech.com/ai-solutions"},
    {"@type": "SiteNavigationElement", "name": "Addons Store", "url": "https://xamltech.com/addons-store"},
    {"@type": "SiteNavigationElement", "name": "Portfolio", "url": "https://xamltech.com/portfolio"},
    {"@type": "SiteNavigationElement", "name": "Insights", "url": "https://xamltech.com/insights"},
    {"@type": "SiteNavigationElement", "name": "Pricing", "url": "https://xamltech.com/pricing"},
    {"@type": "SiteNavigationElement", "name": "Contact", "url": "https://xamltech.com/contact-us"}
  ]
}</script>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         §2. Breadcrumb JSON-LD for pages missing them
         Pages already covered in seo_schemas.xml / blog_seo_schemas.xml:
           erp_page, infra_page, portfolio_page, web_dev_page, store_page, blog articles
         ═══════════════════════════════════════════════════════════ -->

    <!-- Contact Us breadcrumb -->
    <template id="aiseo_contact_breadcrumb"
              inherit_id="xamltech_addons_store.contact_page"
              priority="99">
        <xpath expr="//t[@t-set='title']" position="after">
            <script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://xamltech.com"},
    {"@type": "ListItem", "position": 2, "name": "Contact Us", "item": "https://xamltech.com/contact-us"}
  ]
}</script>
        </xpath>
    </template>

