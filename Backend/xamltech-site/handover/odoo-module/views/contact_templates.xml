<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="contact_page" name="XamlTech Contact">
        <t t-call="website.layout"><t t-set="title">Contact XamlTech — Odoo Development &amp; IT Services in Aswan, Egypt</t>
            <t t-set="meta_description">Contact XamlTech for Odoo ERP implementation, custom module development, IT infrastructure, and CCTV solutions. WhatsApp, email, and phone. Aswan, Egypt.</t>
            <t t-set="og_image">https://xamltech.com/xamltech_addons_store/static/description/banner.png</t>
            <section class="xt-hero" style="padding:60px 0 40px;"><div class="xt-hero__bg"><div class="xt-orb xt-orb--1"/></div><div class="xt-c" style="text-align:center;position:relative;z-index:1;"><p class="xt-tag">✉️ Get in Touch</p><h1 class="xt-hero__h1" style="font-size:40px;">Contact Us</h1><p class="xt-hero__sub" style="max-width:560px;margin:0 auto;">Have a project? Need support? Reach out via the form or WhatsApp.</p></div></section>
            <section class="xt-sec xt-sec--dark"><div class="xt-c"><div class="xt-contact-grid">
                <div class="xt-card" style="padding:32px;">
                    <h3 style="margin-bottom:24px;">Send a Message</h3>
                    <div class="xt-form-row"><div class="xt-fg"><label class="xt-lbl">Name *</label><input type="text" id="ct-name" class="xt-inp" placeholder="Your name"/></div><div class="xt-fg"><label class="xt-lbl">Email *</label><input type="email" id="ct-email" class="xt-inp" placeholder="you@company.com"/></div></div>
                    <div class="xt-form-row"><div class="xt-fg"><label class="xt-lbl">Phone</label><input type="tel" id="ct-phone" class="xt-inp" placeholder="+20 1XX XXX XXXX"/></div><div class="xt-fg"><label class="xt-lbl">Subject</label><select id="ct-subject" class="xt-inp xt-sel"><option value="">Select...</option><option value="ERP">ERP Implementation</option><option value="Web">Web Development</option><option value="Network">Network &amp; IT</option><option value="CCTV">CCTV</option><option value="Odoo Addons">Odoo Addons</option><option value="Support">Technical Support</option><option value="General">General</option></select></div></div>
                    <div class="xt-fg"><label class="xt-lbl">Message *</label><textarea id="ct-msg" class="xt-inp" rows="4" placeholder="Tell us about your project..."></textarea></div>
                    <div class="xt-btns" style="margin-top:20px;"><button type="button" id="ct-wa" class="xt-btn xt-btn--wa">💬 Send via WhatsApp</button><button type="button" id="ct-send" class="xt-btn xt-btn--primary">Send Message</button></div>
                    <div id="ct-status" class="xt-status"/>
                </div>
                <div class="xt-info-list">
                    <div class="xt-info"><span>👨‍💻</span><div><strong>Mahmoud Amen</strong><br/>Founder &amp; Lead Developer</div></div>
                    <a href="https://wa.me/201007982468" target="_blank" class="xt-info xt-info--wa"><span>💬</span><div><strong>WhatsApp</strong><br/>+20 100 798 2468<br/><small>Chat Now →</small></div></a>
                    <a href="tel:+201007982468" class="xt-info"><span>📞</span><div><strong>Phone</strong><br/>+20 100 798 2468</div></a>
                    <a href="mailto:mahmudamen@gmail.com" class="xt-info"><span>✉️</span><div><strong>Email</strong><br/>mahmudamen@gmail.com</div></a>
                    <div class="xt-info"><span>📍</span><div><strong>Location</strong><br/>Sahary, Aswan, Egypt</div></div>
                    <div class="xt-info"><span>🕐</span><div><strong>Hours</strong><br/>Sun–Thu 9AM–6PM</div></div>
                    <div class="xt-info"><span>👨‍💻</span><div><strong>Osama M Salah</strong><br/>+20 120 141 0140</div></div>
                </div>
            </div></div></section>
            <t t-call="xamltech_addons_store.xt_footer_block"/>
        </t>
    </template>
</odoo>
