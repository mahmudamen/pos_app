<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="module_category_xt_eg_trade_control" model="ir.module.category">
    <field name="name">Trade Control</field>
    <field name="sequence">40</field>
  </record>

  <record id="group_trade_user" model="res.groups">
    <field name="name">Trade User</field>
  </record>

  <record id="group_trade_sales" model="res.groups">
    <field name="name">Sales Operator</field>
    <field name="implied_ids" eval="[(4, ref('group_trade_user'))]"/>
  </record>

  <record id="group_trade_stock" model="res.groups">
    <field name="name">Warehouse Operator</field>
    <field name="implied_ids" eval="[(4, ref('group_trade_user'))]"/>
  </record>

  <record id="group_trade_accountant" model="res.groups">
    <field name="name">Trade Accountant</field>
    <field name="implied_ids" eval="[(4, ref('group_trade_user'))]"/>
  </record>

  <record id="group_trade_manager" model="res.groups">
    <field name="name">Trade Manager</field>
    <field name="implied_ids" eval="[(4, ref('group_trade_sales')), (4, ref('group_trade_stock')), (4, ref('group_trade_accountant'))]"/>
  </record>
</odoo>
