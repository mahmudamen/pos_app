<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_eg_trade_eta_document_list" model="ir.ui.view">
    <field name="name">eg.trade.eta.document.list</field>
    <field name="model">eg.trade.eta.document</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'" decoration-warning="state in ('ready','retry')">
        <field name="name"/>
        <field name="document_type"/>
        <field name="partner_id"/>
        <field name="amount_total"/>
        <field name="state"/>
        <field name="eta_uuid"/>
        <field name="retry_count"/>
        <field name="last_send_date"/>
        <field name="responsible_id"/>
      </list>
    </field>
  </record>

  <record id="view_eg_trade_eta_document_form" model="ir.ui.view">
    <field name="name">eg.trade.eta.document.form</field>
    <field name="model">eg.trade.eta.document</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_check_ready" string="Check Data" type="object" class="btn-primary" invisible="state in ('accepted','cancelled')"/>
          <button name="action_mark_sent" string="Mark Sent" type="object" invisible="state not in ('ready','rejected','retry')"/>
          <button name="action_mark_accepted" string="Mark Accepted" type="object" invisible="state != 'sent'"/>
          <button name="action_need_retry" string="Needs Retry" type="object" invisible="state not in ('sent','rejected')"/>
          <button name="action_cancel" string="Cancel" type="object" invisible="state in ('accepted','cancelled')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,ready,sent,accepted,rejected,retry,cancelled"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_source" type="object" class="oe_stat_button" icon="fa-file-text-o">
              <span>Source</span>
            </button>
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="document_type"/>
              <field name="partner_id"/>
              <field name="amount_total"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group>
              <field name="eta_uuid"/>
              <field name="retry_count"/>
              <field name="last_send_date"/>
              <field name="responsible_id"/>
            </group>
          </group>
          <notebook>
            <page string="Review Message">
              <field name="last_error" placeholder="Clear reason appears here if the document is rejected or incomplete."/>
            </page>
            <page string="Payload Preview">
              <field name="payload_preview" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_eg_trade_eta_document" model="ir.actions.act_window">
    <field name="name">Tax Documents</field>
    <field name="res_model">eg.trade.eta.document</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
