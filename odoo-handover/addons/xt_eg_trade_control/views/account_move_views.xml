<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_move_form_eg_trade" model="ir.ui.view">
    <field name="name">account.move.form.eg.trade</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_eg_trade_prepare_eta" type="object" string="Prepare Egypt Tax" invisible="move_type not in ('out_invoice','out_refund')"/>
        <button name="action_eg_trade_open_eta_document" type="object" string="Tax Follow-up" invisible="not eg_trade_eta_document_id"/>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Egypt Tax">
          <group>
            <group>
              <field name="eg_trade_document_type"/>
              <field name="eg_trade_eta_state"/>
              <field name="eg_trade_eta_uuid"/>
              <field name="eg_trade_eta_document_id"/>
            </group>
            <group>
              <field name="eg_trade_eta_message"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <record id="action_eg_trade_invoices" model="ir.actions.act_window">
    <field name="name">Customer Invoices</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('move_type','=','out_invoice')]</field>
    <field name="context">{'default_move_type': 'out_invoice'}</field>
  </record>
</odoo>
