<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_product_template_form_eg_trade" model="ir.ui.view">
    <field name="name">product.template.form.eg.trade</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Egypt Trade">
          <group string="Simple Product Setup">
            <group>
              <field name="eg_trade_internal_code"/>
              <field name="eg_trade_tax_code"/>
              <field name="eg_trade_tax_code_type"/>
              <field name="eg_trade_tax_category"/>
            </group>
            <group>
              <field name="eg_trade_default_vat_rate"/>
              <field name="eg_trade_reorder_min"/>
              <field name="eg_trade_need_serial_or_lot"/>
              <field name="eg_trade_ready" readonly="1"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <record id="action_eg_trade_products" model="ir.actions.act_window">
    <field name="name">Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
  </record>
</odoo>
